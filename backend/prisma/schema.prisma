generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  worksAt   String?
  studiesAt String?
  livesIn   String?
  from      String?
  birthday  DateTime?
  gender    Gender?
  bio       String?

  role Role @default(USER)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews         Review[]
  media           Media[]
  createdEntities Entity[] @relation("EntityCreatedBy")

  following UserFollow[] @relation("UserFollowing")
  followers UserFollow[] @relation("UserFollowers")

  sentRequests     FriendRequest[] @relation("FriendRequestSender")
  receivedRequests FriendRequest[] @relation("FriendRequestReceiver")

  blockedUsers   UserBlock[] @relation("UserBlocker")
  blockedByUsers UserBlock[] @relation("UserBlocked")

  entityFollows EntityFollow[]
  entityBlocks  EntityBlock[]

  friendshipsAsUser1 Friendship[] @relation("FriendshipUser1")
  friendshipsAsUser2 Friendship[] @relation("FriendshipUser2")

  entityMemberships EntityMembership[]
  entityClaims      EntityClaim[]

  entityPosts     EntityPost[]
  reviewReactions ReviewReaction[]
  reviewComments  ReviewComment[]
}

model Category {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  createdAt DateTime @default(now())

  entities Entity[]
}

enum EntityCreationType {
  OWNER
  REVIEWER
}

model Entity {
  id String @id @default(uuid())

  name String
  slug String @unique

  description String?

  location String?
  phone    String?
  website  String?
  email    String?

  businessHours  String?
  priceRange     String?
  serviceOptions String?

  coverPhoto String?
  logo       String?

  amenities      String?
  paymentMethods String?

  socialLinks String?
  menu        String?

  ownerName            String?
  ownerContact         String?
  businessDocument     String?
  businessRelationship String?

  averageRating Float @default(0)

  createdById String?
  categoryId  String?

  category  Category? @relation(fields: [categoryId], references: [id])
  createdBy User?     @relation("EntityCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships EntityMembership[]
  claims      EntityClaim[]
  posts       EntityPost[]

  reviews Review[]
  media   Media[]

  followers      EntityFollow[]
  blockedByUsers EntityBlock[]
}

model Review {
  id String @id @default(uuid())

  rating  Int
  content String

  userId   String
  entityId String

  user   User   @relation(fields: [userId], references: [id])
  entity Entity @relation(fields: [entityId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media           Media[]
  reviewReactions ReviewReaction[]
  reviewComments  ReviewComment[]

  @@unique([userId, entityId])
}

enum MediaType {
  USER_PROFILE
  USER_COVER
  ENTITY_LOGO
  ENTITY_COVER
  REVIEW
  ENTITY_POST
}

model Media {
  id String @id @default(uuid())

  url  String
  type MediaType

  userId       String?
  entityId     String?
  reviewId     String?
  entityPostId String?

  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity     Entity?     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  review     Review?     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  entityPost EntityPost? @relation(fields: [entityPostId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityId])
  @@index([reviewId])
  @@index([type])
  @@index([entityPostId])
}

model UserFollow {
  id String @id @default(uuid())

  followerId  String
  followingId String

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model FriendRequest {
  id String @id @default(uuid())

  senderId   String
  receiverId String

  status FriendRequestStatus @default(PENDING)

  sender   User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([receiverId, status])
}

model Friendship {
  id String @id @default(uuid())

  userId1 String
  userId2 String

  user1 User @relation("FriendshipUser1", fields: [userId1], references: [id], onDelete: Cascade)
  user2 User @relation("FriendshipUser2", fields: [userId2], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId1, userId2])
  @@index([userId1])
  @@index([userId2])
}

model UserBlock {
  id String @id @default(uuid())

  blockerId String
  blockedId String

  blocker User @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model EntityFollow {
  id String @id @default(uuid())

  userId   String
  entityId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, entityId])
  @@index([userId])
  @@index([entityId])
}

model EntityBlock {
  id String @id @default(uuid())

  userId   String
  entityId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, entityId])
  @@index([userId])
  @@index([entityId])
}

enum EntityRole {
  OWNER
  ADMIN
  EDITOR
}

model EntityMembership {
  id String @id @default(uuid())

  userId   String
  entityId String

  role EntityRole @default(OWNER)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, entityId])
  @@index([userId])
  @@index([entityId])
}

enum EntityClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model EntityClaim {
  id String @id @default(uuid())

  entityId String
  userId   String

  status EntityClaimStatus @default(PENDING)

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, entityId])
  @@index([entityId])
  @@index([userId])
  @@index([status])
}

model EntityPost {
  id String @id @default(uuid())

  entityId String
  authorId String

  content String
  media   Media[]

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityId])
  @@index([authorId])
}

enum ReactionType {
  HELPFUL
  LOVE
  ACCURATE
  HAHA
  DISLIKE
}

model ReviewReaction {
  id        String       @id @default(uuid())
  type      ReactionType
  userId    String
  reviewId  String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, reviewId])
  @@index([reviewId])
  @@index([userId])
}

model ReviewComment {
  id        String          @id @default(uuid())
  content   String
  userId    String
  reviewId  String
  parentId  String?
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  parent    ReviewComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ReviewComment[] @relation("CommentReplies")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([reviewId])
  @@index([parentId])
  @@index([userId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum FriendListVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  worksAtEntityId String?
  worksAtEntity   Entity? @relation("UserWorksAt", fields: [worksAtEntityId], references: [id], onDelete: SetNull)
  studiesAt       String?

  livesInLocationId String?
  livesInLocation   Location? @relation("UserLivesIn", fields: [livesInLocationId], references: [id])
  fromLocationId    String?
  fromLocation      Location? @relation("UserFrom", fields: [fromLocationId], references: [id])
  birthday          DateTime?
  gender            Gender?
  bio               String?

  friendListVisibility FriendListVisibility @default(PUBLIC)
  role                 Role                 @default(USER)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews         Review[]
  media           Media[]
  createdEntities Entity[] @relation("EntityCreatedBy")

  following UserFollow[] @relation("UserFollowing")
  followers UserFollow[] @relation("UserFollowers")

  sentRequests     FriendRequest[] @relation("FriendRequestSender")
  receivedRequests FriendRequest[] @relation("FriendRequestReceiver")

  blockedUsers   UserBlock[] @relation("UserBlocker")
  blockedByUsers UserBlock[] @relation("UserBlocked")

  entityFollows EntityFollow[]
  entityBlocks  EntityBlock[]

  friendshipsAsUser1 Friendship[] @relation("FriendshipUser1")
  friendshipsAsUser2 Friendship[] @relation("FriendshipUser2")

  entityMemberships EntityMembership[]
  entityClaims      EntityClaim[]

  entityPosts              EntityPost[]
  reviewReactions          ReviewReaction[]
  reviewComments           ReviewComment[]
  postReactions            PostReaction[]
  postComments             PostComment[]
  verificationApplications EntityVerification[] @relation("VerificationApplicant")
  verificationReviews      EntityVerification[] @relation("VerificationReviewer")
  shares                   Share[]
  shareReactions           ShareReaction[]
  shareComments            ShareComment[]

  askedQuestions    EntityQuestion[] @relation("QuestionAsker")
  answeredQuestions EntityQuestion[] @relation("QuestionAnswerer")

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")
}

enum NotificationType {
  NEW_REVIEW
  REVIEW_REACTION
  REVIEW_COMMENT
  REVIEW_REPLY
  POST_REACTION
  POST_COMMENT
  POST_REPLY
  NEW_FOLLOWER
  NEW_ENTITY_FOLLOWER
  FRIEND_REQUEST
  FRIEND_REQUEST_ACCEPTED
  CLAIM_APPROVED
  CLAIM_REJECTED
  QUESTION_ASKED
  QUESTION_ANSWERED
  ENTITY_COMMENT_REPLY
  SHARE_REACTION
  SHARE_COMMENT
  SHARE_REPLY
  REVIEW_SHARED
  POST_SHARED
  VERIFICATION_UPDATE
}

model Notification {
  id String @id @default(uuid())

  recipientId String
  actorId     String?

  type    NotificationType
  message String
  link    String?

  entityId String?
  reviewId String?
  postId   String?

  isRead Boolean @default(false)

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([recipientId])
  @@index([recipientId, isRead])
  @@index([createdAt])
}

model Location {
  id String @id @default(uuid())

  name String
  tier Int
  type String?

  parentId String?
  parent   Location?  @relation("LocationChildren", fields: [parentId], references: [id])
  children Location[] @relation("LocationChildren")

  entities     Entity[]
  livesInUsers User[]   @relation("UserLivesIn")
  fromUsers    User[]   @relation("UserFrom")

  ancestorOf   LocationClosure[] @relation("Ancestor")
  descendantOf LocationClosure[] @relation("Descendant")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, name])
  @@index([parentId])
}

// Closure Table — প্রতিটা location-এর সব ancestor/descendant pair এখানে
// আলাদাভাবে সংরক্ষিত থাকে, তাই "এর নিচে সব location কী কী" জানতে
// recursive query লাগে না, শুধু একটা সরল WHERE ancestorId = X query লাগে।
model LocationClosure {
  ancestorId   String
  descendantId String
  depth        Int

  ancestor   Location @relation("Ancestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant Location @relation("Descendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  @@index([ancestorId])
  @@index([descendantId])
}

model Amenity {
  id   String @id @default(uuid())
  name String @unique

  entities Entity[]

  createdAt DateTime @default(now())
}

model BusinessHour {
  id String @id @default(uuid())

  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  // 0 = Sunday, 1 = Monday, ... 6 = Saturday (JS Date.getDay() convention)
  dayOfWeek Int

  // true হলে এই day পুরো বন্ধ — openTime/closeTime তখন null থাকে।
  // false হলে openTime/closeTime দুটোই লাগবে ("HH:mm", 24hr format)।
  isClosed  Boolean @default(false)
  openTime  String?
  closeTime String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // প্রতি entity-তে প্রতি day-র জন্য একটাই row — তাই একই day একসাথে
  // "open" আর "closed" দুটো হয়ে যাওয়া, বা duplicate row তৈরি হওয়া
  // schema-লেভেলেই সম্ভব না।
  @@unique([entityId, dayOfWeek])
  @@index([entityId])
}

model PaymentMethod {
  id   String @id @default(uuid())
  name String @unique

  entities Entity[]

  createdAt DateTime @default(now())
}

model Category {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  createdAt DateTime @default(now())

  entities Entity[]

  subCategories SubCategory[]
}

model SubCategory {
  id String @id @default(uuid())

  name String
  slug String @unique

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  entities Entity[]

  @@unique([categoryId, name])
}

enum EntityCreationType {
  OWNER
  REVIEWER
}

model Entity {
  id String @id @default(uuid())

  name String
  slug String @unique

  description String?

  location      String?
  locationId    String?
  locationNode  Location? @relation(fields: [locationId], references: [id])
  phone         String?
  website       String?
  googleMapsUrl String?   @db.VarChar(500)
  email         String?

  businessHours  BusinessHour[]
  priceRange     String?
  serviceOptions String?

  coverPhoto String?
  logo       String?

  amenities      Amenity[]
  paymentMethods PaymentMethod[]

  socialLinks String?
  menu        String?

  ownerName            String?
  ownerContact         String?
  businessDocument     String?
  businessRelationship String?

  averageRating Float         @default(0)
  badgeOverride BadgeOverride @default(AUTO)
  isVerified    Boolean       @default(false)
  verifiedAt    DateTime?
  verifiedUntil DateTime?

  createdById   String?
  categoryId    String?
  subCategoryId String?

  category    Category?    @relation(fields: [categoryId], references: [id])
  createdBy   User?        @relation("EntityCreatedBy", fields: [createdById], references: [id])
  subCategory SubCategory? @relation(fields: [subCategoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   EntityMembership[]
  claims        EntityClaim[]
  posts         EntityPost[]
  offerings     Offering[]
  questions     EntityQuestion[]
  verifications EntityVerification[]
  subscription  EntitySubscription?

  reviewComments  ReviewComment[]  @relation("ReviewCommentEntity")
  reviewReactions ReviewReaction[] @relation("ReviewReactionEntity")

  reviews Review[]
  media   Media[]

  followers      EntityFollow[]
  blockedByUsers EntityBlock[]

  employees User[] @relation("UserWorksAt")

  @@index([locationId])
}

model Offering {
  id String @id @default(uuid())

  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  name        String
  type        String
  price       Float
  description String?

  averageRating Float   @default(0)
  isPublic      Boolean @default(true)

  media   Media[]
  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityId])
  @@index([entityId, isPublic])
}

model Review {
  id String @id @default(uuid())

  rating  Int
  content String

  userId     String
  entityId   String
  offeringId String?
  isLatest   Boolean @default(true)

  user     User      @relation(fields: [userId], references: [id])
  entity   Entity    @relation(fields: [entityId], references: [id])
  offering Offering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media           Media[]
  reviewReactions ReviewReaction[]
  reviewComments  ReviewComment[]
  shares          Share[]

  @@index([userId, entityId, offeringId])
  @@index([entityId, isLatest])
  @@index([offeringId, isLatest])
}

enum MediaType {
  USER_PROFILE
  USER_COVER
  ENTITY_LOGO
  ENTITY_COVER
  REVIEW
  ENTITY_POST
  OFFERING
}

model Media {
  id String @id @default(uuid())

  url  String
  type MediaType

  userId       String?
  entityId     String?
  reviewId     String?
  entityPostId String?
  offeringId   String?

  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity     Entity?     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  review     Review?     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  entityPost EntityPost? @relation(fields: [entityPostId], references: [id], onDelete: Cascade)
  offering   Offering?   @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityId])
  @@index([reviewId])
  @@index([type])
  @@index([entityPostId])
  @@index([offeringId])
}

model UserFollow {
  id String @id @default(uuid())

  followerId  String
  followingId String

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model FriendRequest {
  id String @id @default(uuid())

  senderId   String
  receiverId String

  status FriendRequestStatus @default(PENDING)

  sender   User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([receiverId, status])
}

model Friendship {
  id String @id @default(uuid())

  userId1 String
  userId2 String

  user1 User @relation("FriendshipUser1", fields: [userId1], references: [id], onDelete: Cascade)
  user2 User @relation("FriendshipUser2", fields: [userId2], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId1, userId2])
  @@index([userId1])
  @@index([userId2])
}

model UserBlock {
  id String @id @default(uuid())

  blockerId String
  blockedId String

  blocker User @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model EntityFollow {
  id String @id @default(uuid())

  userId   String
  entityId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, entityId])
  @@index([userId])
  @@index([entityId])
}

model EntityBlock {
  id String @id @default(uuid())

  userId   String
  entityId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, entityId])
  @@index([userId])
  @@index([entityId])
}

enum EntityRole {
  OWNER
  ADMIN
  EDITOR
}

model EntityMembership {
  id String @id @default(uuid())

  userId   String
  entityId String

  role EntityRole @default(OWNER)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, entityId])
  @@index([userId])
  @@index([entityId])
}

enum EntityClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model EntityClaim {
  id String @id @default(uuid())

  entityId String
  userId   String

  status EntityClaimStatus @default(PENDING)

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, entityId])
  @@index([entityId])
  @@index([userId])
  @@index([status])
}

model EntityPost {
  id String @id @default(uuid())

  entityId String
  authorId String

  content String
  media   Media[]

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reactions PostReaction[]
  comments  PostComment[]
  shares    Share[]

  @@index([entityId])
  @@index([authorId])
}

enum ReactionType {
  HELPFUL
  LOVE
  ACCURATE
  HAHA
  DISLIKE
}

model ReviewReaction {
  id       String       @id @default(uuid())
  type     ReactionType
  userId   String
  reviewId String
  entityId String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  entity    Entity?  @relation("ReviewReactionEntity", fields: [entityId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, reviewId])
  @@index([reviewId])
  @@index([userId])
  @@index([entityId])
}

model ReviewComment {
  id       String  @id @default(uuid())
  content  String
  userId   String
  reviewId String
  parentId String?
  entityId String?

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  entity    Entity?         @relation("ReviewCommentEntity", fields: [entityId], references: [id], onDelete: SetNull)
  parent    ReviewComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ReviewComment[] @relation("CommentReplies")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([reviewId])
  @@index([parentId])
  @@index([userId])
  @@index([entityId])
}

model PostReaction {
  id String @id @default(uuid())

  type ReactionType // আগের এনাম-ই reuse করা হচ্ছে (HELPFUL/LOVE/ACCURATE/HAHA/DISLIKE)

  userId String
  postId String

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  post EntityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model PostComment {
  id String @id @default(uuid())

  content String

  userId String
  postId String

  parentId String?

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    EntityPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent  PostComment?  @relation("PostCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies PostComment[] @relation("PostCommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([parentId])
  @@index([userId])
}

model EntityQuestion {
  id String @id @default(uuid())

  entityId String
  askerId  String

  question     String    @db.VarChar(500)
  answer       String?   @db.VarChar(2000)
  answeredById String?
  answeredAt   DateTime?

  entity     Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  asker      User   @relation("QuestionAsker", fields: [askerId], references: [id], onDelete: Cascade)
  answeredBy User?  @relation("QuestionAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityId, createdAt])
  @@index([askerId])
}

model Share {
  id String @id @default(uuid())

  userId       String
  reviewId     String?
  entityPostId String?

  caption String? @db.VarChar(500)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  review     Review?     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  entityPost EntityPost? @relation(fields: [entityPostId], references: [id], onDelete: Cascade)

  reactions ShareReaction[]
  comments  ShareComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([reviewId])
  @@index([entityPostId])
}

model ShareReaction {
  id String @id @default(uuid())

  type ReactionType

  userId  String
  shareId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  share Share @relation(fields: [shareId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, shareId])
  @@index([shareId])
  @@index([userId])
}

model ShareComment {
  id String @id @default(uuid())

  content String

  userId  String
  shareId String

  parentId String?

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  share   Share          @relation(fields: [shareId], references: [id], onDelete: Cascade)
  parent  ShareComment?  @relation("ShareCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies ShareComment[] @relation("ShareCommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shareId])
  @@index([parentId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Business Verification — "Verified" badge-এর আবেদন ও review।
// Status: PENDING → UNDER_REVIEW → APPROVED / REJECTED।
// APPROVED হলে Entity.isVerified = true (১ বছর validity), আর Admin
// পরে REVOKED করতে পারে; মেয়াদ শেষ হলে EXPIRED (renew করতে হয়)।
// Document-এর file private ও encrypted — DB-তে শুধু metadata।
// ─────────────────────────────────────────────────────────────
enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  REVOKED
  EXPIRED
}

enum VerificationDocType {
  NID
  PASSPORT
  BUSINESS_REGISTRATION
  TRADE_LICENSE
  OTHER
}

model EntityVerification {
  id String @id @default(uuid())

  entityId    String
  applicantId String

  status VerificationStatus @default(PENDING)

  applicantNote String? @db.VarChar(1000)

  reviewerId String?
  reviewedAt DateTime?
  // reject বা revoke করার কারণ — business-কে দেখানো হয়
  reviewNote String?   @db.VarChar(1000)

  approvedAt DateTime?
  expiresAt  DateTime?

  entity    Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  applicant User   @relation("VerificationApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  reviewer  User?  @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  documents VerificationDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityId, createdAt])
  @@index([status, createdAt])
}

model VerificationDocument {
  id String @id @default(uuid())

  verificationId String

  type         VerificationDocType
  originalName String
  mimeType     String
  size         Int

  // Private disk-এ encrypted file-এর নাম (public URL নেই)
  storageKey String @unique

  verification EntityVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([verificationId])
}

enum PlanTier {
  FREE
  STARTER
  GROWTH
  PRO
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionSource {
  ADMIN
  PAYMENT
}

enum BadgeOverride {
  AUTO
  FORCE_ON
  FORCE_OFF
}

model EntitySubscription {
  id String @id @default(uuid())

  entityId String @unique

  plan         PlanTier
  billingCycle BillingCycle

  startsAt DateTime
  endsAt   DateTime

  nextPlan         PlanTier?
  nextBillingCycle BillingCycle?

  source SubscriptionSource @default(ADMIN)

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([endsAt])
}
